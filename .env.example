QWEN_API_KEY=your-api-key
QWEN_BASE_URL=your-openai-compatible-base-url

MILVUS_URI=http://localhost:19530
# API容器访问宿主机Milvus时使用
MILVUS_DOCKER_URI=http://host.docker.internal:19530
MILVUS_COLLECTION=researchflow_chunks_v1

# PostgreSQL for LangGraph checkpoints and long-term memory
POSTGRES_DB=researchflow
POSTGRES_USER=researchflow
POSTGRES_PASSWORD=replace-with-a-strong-local-password
POSTGRES_PORT=5432
POSTGRES_URI=postgresql://researchflow:replace-with-a-strong-local-password@localhost:5432/researchflow

# Redis cache and shared rate limiting
REDIS_URI=redis://localhost:6379/0
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_PORT=6379
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_SECONDS=300

# Restrict LangGraph checkpoint deserialization
LANGGRAPH_STRICT_MSGPACK=true

API_PORT=8000
# Production reverse proxy and local Prometheus binding
DOMAIN=localhost
PROMETHEUS_PORT=9090

# JWT authentication. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=researchflow-api
JWT_AUDIENCE=researchflow-client

# MCP HTTP resource-server authentication
MCP_AUTH_ENABLED=true
MCP_ISSUER_URL=http://127.0.0.1:8000
MCP_RESOURCE_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_JWT_AUDIENCE=http://127.0.0.1:8001/mcp
MCP_ACCESS_TOKEN_EXPIRE_MINUTES=15
MCP_REQUIRED_SCOPES=research:read,research:write

# Reliability and traffic protection
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=2
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Retrieval quality: similarity or mmr
RETRIEVAL_STRATEGY=mmr
RETRIEVAL_FETCH_K_MULTIPLIER=4
RETRIEVAL_MMR_LAMBDA=0.65

# text or json
LOG_FORMAT=json

# MCP Streamable HTTP service
MCP_HOST=127.0.0.1
MCP_PORT=8001

DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=your-openai-compatible-base-url
DEEPSEEK_CHAT_MODEL=deepseek-chat
