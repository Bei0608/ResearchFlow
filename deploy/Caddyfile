{$DOMAIN:localhost} {
	encode zstd gzip

	route {
		@internal path /metrics /metrics/*
		respond @internal 404

		@mcp path /mcp* /.well-known/oauth-protected-resource*
		reverse_proxy @mcp mcp:8001 {
			transport http {
				dial_timeout 3s
				response_header_timeout 90s
			}
		}

		reverse_proxy api:8000 {
			health_uri /api/v1/health/live
			health_interval 10s
			transport http {
				dial_timeout 3s
				response_header_timeout 90s
			}
		}
	}
}
